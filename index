  <style>
    :root { color-scheme: light; --bg:#f7f8fa; --surface:#fff; --surface-alt:#eff2f5; --text:#111316; --muted:#626b76; --line:#d9dee4; --green:#10ae69; --blue:#2478d3; --orange:#c65a18; --red:#d9383b; --shadow:0 18px 48px rgba(17,19,22,.08); }
    html[data-theme="dark"] { color-scheme:dark; --bg:#101214; --surface:#171a1e; --surface-alt:#20242a; --text:#f6f7f8; --muted:#adb5bf; --line:#303740; --shadow:0 20px 52px rgba(0,0,0,.30); }
    * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--bg); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; line-height:1.55; transition:background .22s ease,color .22s ease; } a { color:inherit; text-decoration:none; } button { font:inherit; } .container { width:min(1160px,calc(100% - 40px)); margin:auto; } .eyebrow { color:var(--muted); font-size:.76rem; font-weight:800; letter-spacing:.15em; text-transform:uppercase; }
    .site-header { position:sticky; top:0; z-index:30; border-bottom:1px solid var(--line); background:color-mix(in srgb,var(--bg) 90%,transparent); backdrop-filter:blur(14px); } .nav { min-height:76px; display:flex; align-items:center; justify-content:space-between; gap:24px; } .brand { display:inline-flex; align-items:center; min-width:max-content; } .brand img { display:block; width:auto; max-width:215px; height:42px; object-fit:contain; object-position:left center; } .nav-links { display:flex; align-items:center; gap:25px; font-size:.89rem; font-weight:700; } .nav-links a { color:var(--muted); } .nav-links a:hover { color:var(--text); } .theme-toggle { width:42px; height:42px; display:inline-grid; place-items:center; border:1px solid var(--line); border-radius:50%; background:var(--surface); color:var(--text); cursor:pointer; } .theme-toggle:hover { border-color:var(--text); } .theme-icon { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .hero { padding:100px 0 75px; overflow:hidden; } .hero-grid { display:grid; grid-template-columns:1.15fr .85fr; gap:56px; align-items:center; } h1 { max-width:760px; margin:14px 0 23px; font-size:clamp(3rem,6vw,5.55rem); letter-spacing:-.065em; line-height:.98; } .hero p { max-width:610px; color:var(--muted); font-size:1.13rem; } .hero-actions { display:flex; flex-wrap:wrap; gap:13px; margin-top:34px; } .button { display:inline-flex; align-items:center; justify-content:center; min-height:50px; padding:0 21px; border:1px solid var(--text); font-size:.88rem; font-weight:800; letter-spacing:.02em; transition:transform .15s ease,background .15s ease; } .button:hover { transform:translateY(-2px); } .button.primary { background:var(--text); color:var(--bg); } .button.secondary { background:transparent; color:var(--text); } .hero-art { position:relative; min-height:410px; border:1px solid var(--line); background:var(--surface); box-shadow:var(--shadow); overflow:hidden; display:grid; place-items:center; } .grid-lines { position:absolute; inset:0; opacity:.9; background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,#000 20%,transparent 90%); } .signal { position:relative; width:245px; aspect-ratio:1; border:2px solid var(--text); transform:rotate(45deg); display:grid; place-items:center; } .signal::before,.signal::after { content:""; position:absolute; background:var(--text); } .signal::before { width:100%; height:2px; } .signal::after { height:100%; width:2px; } .signal span { position:relative; z-index:1; width:122px; height:122px; background:var(--surface); border:2px solid var(--text); } .signal-label { position:absolute; bottom:26px; left:26px; font-size:.72rem; font-weight:800; letter-spacing:.14em; color:var(--muted); } .signal-code { position:absolute; right:26px; top:25px; font-size:.67rem; letter-spacing:.12em; color:var(--muted); }
    .capabilities { border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:var(--surface); } .capability-row { display:grid; grid-template-columns:repeat(4,1fr); } .capability { min-height:106px; padding:20px; border-right:1px solid var(--line); display:flex; align-items:center; } .capability:last-child { border-right:0; } .division-logo { display:block; width:100%; max-width:220px; height:57px; object-fit:contain; object-position:left center; }
    section { padding:104px 0; } .section-heading { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:40px; } h2 { max-width:720px; margin:9px 0 0; font-size:clamp(2.05rem,4vw,3.55rem); letter-spacing:-.05em; line-height:1.05; } .section-intro { max-width:390px; margin:0; color:var(--muted); } .service-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; } .service-card { min-height:325px; padding:29px; position:relative; border:1px solid var(--line); background:var(--surface); overflow:hidden; transition:transform .18s ease,border-color .18s ease; } .service-card:hover { transform:translateY(-5px); border-color:var(--text); } .service-card p { color:var(--muted); margin:25px 0 0; max-width:460px; font-size:.93rem; } .service-card::after { content:""; position:absolute; right:-42px; bottom:-42px; width:156px; height:156px; border:1px solid currentColor; border-radius:50%; opacity:.14; } .service-card.it { color:var(--green); } .service-card.cyber { color:var(--orange); } .service-card.electrical { color:var(--blue); } .service-card.security { color:var(--red); } .service-logo { display:block; width:auto; max-width:min(100%,270px); height:57px; object-fit:contain; object-position:left center; position:relative; z-index:1; } .service-tag { display:block; margin-top:22px; color:currentColor; font-size:.7rem; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
    .approach { background:var(--surface-alt); border-top:1px solid var(--line); border-bottom:1px solid var(--line); } .approach-grid { display:grid; grid-template-columns:.75fr 1.25fr; gap:60px; } .approach-copy p { color:var(--muted); max-width:370px; } .steps { border-top:1px solid var(--line); } .step { display:grid; grid-template-columns:86px 1fr auto; gap:20px; align-items:center; padding:23px 0; border-bottom:1px solid var(--line); } .step-no { color:var(--muted); font-size:.76rem; font-weight:800; letter-spacing:.12em; } .step strong { font-size:1.08rem; } .step p { margin:4px 0 0; color:var(--muted); font-size:.9rem; } .arrow { color:var(--muted); font-size:1.3rem; }
    .contact { padding:102px 0; } .contact-panel { padding:clamp(32px,6vw,72px); background:var(--text); color:var(--bg); display:grid; grid-template-columns:1fr auto; gap:30px; align-items:end; } .contact-panel .eyebrow { color:color-mix(in srgb,var(--bg) 66%,transparent); } .contact-panel h2 { max-width:710px; margin-bottom:0; } .contact-panel .button { color:var(--text); background:var(--bg); border-color:var(--bg); white-space:nowrap; } footer { padding:30px 0 38px; border-top:1px solid var(--line); } .footer-row { display:flex; align-items:center; justify-content:space-between; gap:24px; } .footer-copy,.footer-links { color:var(--muted); font-size:.78rem; } .footer-links { display:flex; gap:20px; }
    @media (max-width:900px) { .nav-links { display:none; } .hero { padding-top:65px; } .hero-grid,.approach-grid { grid-template-columns:1fr; gap:40px; } .hero-art { min-height:330px; } .section-heading,.contact-panel { grid-template-columns:1fr; display:grid; align-items:start; } .capability-row { grid-template-columns:repeat(2,1fr); } .capability:nth-child(2) { border-right:0; } .capability:nth-child(-n+2) { border-bottom:1px solid var(--line); } } @media (max-width:640px) { .service-grid,.capability-row { grid-template-columns:1fr; } .capability { border-right:0; border-bottom:1px solid var(--line); } .capability:nth-child(2) { border-bottom:1px solid var(--line); } .capability:last-child { border-bottom:0; } .service-card { min-height:270px; } .footer-row { align-items:flex-start; flex-direction:column; } } @media (max-width:430px) { .container { width:min(100% - 28px,1160px); } .brand img { max-width:180px; height:36px; } .step { grid-template-columns:52px 1fr; } .arrow { display:none; } section { padding:72px 0; } }
  </style>
